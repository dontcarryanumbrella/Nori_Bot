# Copy the lines you need into .env (never commit .env).

# --- Chat model -------------------------------------------------------------
# Default: OpenAI, using OPENAI_API_KEY.
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Local model through LM Studio (Developer tab -> Start Server). Free and offline, but speed
# depends on your hardware. Use the model id shown by http://127.0.0.1:1234/v1/models.
# LLM_REASONING_EFFORT=none turns off "thinking" (otherwise Qwen can reason for minutes first).
# LLM_BASE_URL=http://127.0.0.1:1235/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3.5-4b-uncensored-hauhaucs-aggressive
# LLM_REASONING_EFFORT=none

# --- Text-to-speech -----------------------------------------------------------
# Default: free Microsoft Edge voice, no key needed. Tweak the voice if you like
# (list voices with: python -m edge_tts --list-voices).
# TTS_PROVIDER=edge
# EDGE_TTS_VOICE=en-US-BrianNeural
# EDGE_TTS_PITCH=+25Hz
# EDGE_TTS_RATE=+8%

# OpenAI voices instead (paid, uses OPENAI_API_KEY unless TTS_API_KEY is set).
# TTS_PROVIDER=openai
# TTS_VOICE=alloy
# TTS_MODEL=gpt-4o-mini-tts
# TTS_BASE_URL=
# TTS_API_KEY=
